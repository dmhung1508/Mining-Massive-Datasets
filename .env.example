MONGO_URI=
MONGO_DB_NAME=telegram_data
MONGO_COLLECTION_NAME=messages

# X posts (news_monitoring DB). Set only if X lives on a different cluster than
# Telegram; otherwise it falls back to MONGO_URI.
NEWS_MONGO_URI=
NEWS_DB_NAME=news_monitoring

API_KEY=
MODEL=grok-4-1-fast-non-reasoning
XAI_BASE_URL=https://api.yescale.io/v1

# Video + image generation (YEScale)
API_VEO=
base_url_veo=https://api.yescale.io/task/submit
VEO_MODEL=grok-video
IMAGE_MODEL=gpt-image

# Text-to-speech (PTIT Holobox)
TTS_URL=https://aitools.ptit.edu.vn/holobox/synthesize
